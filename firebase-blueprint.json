{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User's business data and settings",
      "type": "object",
      "properties": {
        "business": {
          "type": "object",
          "description": "Business details"
        },
        "savedCustomers": {
          "type": "array",
          "description": "List of saved customers"
        },
        "savedSuppliers": {
          "type": "array",
          "description": "List of saved suppliers"
        },
        "history": {
          "type": "array",
          "description": "Document history"
        },
        "lastUsedNumbers": {
          "type": "object",
          "description": "Last used document numbers"
        },
        "priceHistory": {
          "type": "array",
          "description": "Price history for products"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "accountStatus": {
          "type": "string",
          "description": "Account status (e.g. Active, Suspended)"
        },
        "plan": {
          "type": "string",
          "description": "Subscription plan name and limits"
        },
        "planTier": {
          "type": "string",
          "description": "Plan tier key (free-trial, pro, enterprise, expired)"
        },
        "documentsRemaining": {
          "type": "number",
          "description": "Remaining documents allowed"
        },
        "documentsUsed": {
          "type": "number",
          "description": "Number of documents created"
        },
        "trialUsed": {
          "type": "boolean",
          "description": "Flag indicating if free trial has been consumed"
        },
        "isReRegisteredUser": {
          "type": "boolean",
          "description": "Flag indicating if user previously registered with this email"
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal admin notes regarding customer ticket/complaints"
        },
        "logs": {
          "type": "array",
          "description": "Audit trail logs"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last sync timestamp"
        }
      }
    },
    "TrialLedger": {
      "title": "Trial Ledger",
      "description": "Permanent anti-abuse trial tracking record persisted independently of user accounts",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Normalized email address"
        },
        "trialUsed": {
          "type": "boolean",
          "description": "Whether the trial was consumed for this email"
        },
        "documentsRemaining": {
          "type": "number",
          "description": "Number of free trial documents remaining"
        },
        "documentsUsed": {
          "type": "number",
          "description": "Number of documents created using this email"
        },
        "planTier": {
          "type": "string",
          "description": "Current plan tier associated with email ledger"
        },
        "planName": {
          "type": "string",
          "description": "Human readable plan name"
        },
        "firstCreatedUid": {
          "type": "string",
          "description": "Firebase UID of first account created with this email"
        },
        "isReRegisteredUser": {
          "type": "boolean",
          "description": "Whether account was created by a re-registered email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ErrorLog": {
      "title": "Application Error Log",
      "description": "Real-time incident log captured from user runtime exceptions",
      "type": "object",
      "properties": {
        "errorSummary": { "type": "string", "description": "Plain English translated summary" },
        "rawError": { "type": "string", "description": "Raw technical message or stack trace" },
        "affectedUserEmail": { "type": "string", "description": "User email affected" },
        "userId": { "type": "string", "description": "User UID affected" },
        "pageRoute": { "type": "string", "description": "Screen or component where error occurred" },
        "action": { "type": "string", "description": "Action being performed when error occurred" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "resolved"] },
        "occurrenceCount": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User-specific data"
    },
    "/trialLedgers/{emailKey}": {
      "schema": "TrialLedger",
      "description": "Anti-abuse permanent trial tracking ledger keyed by email"
    },
    "/errorLogs/{logId}": {
      "schema": "ErrorLog",
      "description": "Real-time application health incident logs"
    }
  }
}
